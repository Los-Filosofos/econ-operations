APP_NAME="ECON Integration API"
# uv run --env-file .env applies UTF-8 before Python starts on Windows.
PYTHONUTF8=1
# Base central de desarrollo: docker compose up -d --wait db
DATABASE_URL=postgresql+psycopg://econ:econ_local_only@localhost:54329/econ
# Alternativa local sin Docker: DATABASE_URL=sqlite:///./econ.db
# Session login. AUTH_REQUIRED=false is only for local development without users.
AUTH_REQUIRED=true
# Required when AUTH_REQUIRED=true: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Set true behind HTTPS so the cookie is never sent over plain HTTP.
SESSION_HTTPS_ONLY=false
SESSION_MAX_AGE_SECONDS=28800
# First administrator: uv run python -m app.cli.create_user --email admin@example.com --role admin
# Public fixture deployments keep live reads disabled.
ALLOW_LIVE_READS=false
# All provider records in this project are synthetic sandbox data.
# Management switch for services/workflow. With AUTH_REQUIRED=true the authority is the
# session role (manage_transfers / declare_reception); with AUTH_REQUIRED=false it also
# requires a loopback, same-origin request.
ALLOW_LOCAL_MANAGEMENT=false
ALLOW_LIVE_WRITES=false
AUTO_QUEUE_TRANSFERS=false
# Startrack API credentials are separate from a browser session.
STARTRACK_API_KEY=
STARTRACK_PASSWORD=
STARTRACK_PAGE_SIZE=25
STARTRACK_MAX_PAGES=2
STARTRACK_TIMEOUT_SECONDS=5
STARTRACK_BUDGET_SECONDS=20
# Server-only credentials; never use VITE_ variables or commit real values.
NEXUS_EMAIL=
NEXUS_PASSWORD=
NEXUS_PAGE_SIZE=25
NEXUS_MAX_PAGES=2
NEXUS_TIMEOUT_SECONDS=5
NEXUS_BUDGET_SECONDS=20
