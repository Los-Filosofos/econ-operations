APP_NAME="ECON Integration API"
# uv run --env-file .env applies UTF-8 before Python starts on Windows.
PYTHONUTF8=1
# Base central de desarrollo: docker compose up -d --wait db
DATABASE_URL=postgresql+psycopg://econ:econ_local_only@127.0.0.1:54329/econ
# Alternativa local sin Docker: DATABASE_URL=sqlite:///./econ.db
# Session login. AUTH_REQUIRED=false is only for local development without users.
AUTH_REQUIRED=true
# Required when AUTH_REQUIRED=true: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Default true (cookie only over HTTPS); false solo desarrollo local por HTTP.
SESSION_HTTPS_ONLY=false
SESSION_MAX_AGE_SECONDS=28800
# First administrator (after alembic upgrade head; the password is prompted, never an argument):
#   uv run --directory apps/api python -m app.cli.create_user --email admin@example.com --role admin --name "Administración"
# Roles: admin, gerencia_proyecto, logistica, mantenimiento, control_costos, lectura (docs/adr/0005-session-auth-and-roles.md).
# Public fixture deployments keep live reads disabled.
ALLOW_LIVE_READS=false
# All provider records in this project are synthetic sandbox data.
# With AUTH_REQUIRED=true management authority is the session role (manage_transfers /
# declare_reception) and this flag is ignored. With AUTH_REQUIRED=false (development only)
# it grants management to loopback, same-origin requests.
ALLOW_LOCAL_MANAGEMENT=false
ALLOW_LIVE_WRITES=false
AUTO_QUEUE_TRANSFERS=false
# In-process live synchronization: 0 keeps it off; otherwise one bounded live cycle every
# N seconds (minimum 30) under the PostgreSQL cycle lock. Requires ALLOW_LIVE_READS=true; it
# never runs for fixture. The page polls GET /api/v1/status and reloads only on change.
SYNC_INTERVAL_SECONDS=0
# Startrack API credentials are separate from a browser session.
STARTRACK_API_KEY=
STARTRACK_PASSWORD=
STARTRACK_PAGE_SIZE=25
STARTRACK_MAX_PAGES=2
STARTRACK_TIMEOUT_SECONDS=5
STARTRACK_BUDGET_SECONDS=20
# Server-only credentials; never use VITE_ variables or commit real values.
NEXUS_EMAIL=
NEXUS_PASSWORD=
NEXUS_PAGE_SIZE=25
NEXUS_MAX_PAGES=2
NEXUS_TIMEOUT_SECONDS=5
NEXUS_BUDGET_SECONDS=20
