APP_NAME="ECON Integration API"
# uv run --env-file .env applies UTF-8 before Python starts on Windows.
PYTHONUTF8=1
# Base central de desarrollo: docker compose up -d --wait db
DATABASE_URL=postgresql+psycopg://econ:econ_local_only@localhost:54329/econ
# Alternativa local sin Docker: DATABASE_URL=sqlite:///./econ.db
CORS_ORIGINS='["http://localhost:3000","http://localhost:5173"]'
# Public fixture deployments keep live reads disabled. No application login is used.
ALLOW_LIVE_READS=false
# All provider records in this project are synthetic sandbox data.
# Local management requires loopback + same-origin requests; disabled for public demos.
ALLOW_LOCAL_MANAGEMENT=false
ALLOW_LIVE_WRITES=false
AUTO_QUEUE_TRANSFERS=false
# Startrack API credentials are separate from a browser session.
STARTRACK_API_KEY=
STARTRACK_PASSWORD=
STARTRACK_PAGE_SIZE=25
STARTRACK_MAX_PAGES=2
STARTRACK_TIMEOUT_SECONDS=5
STARTRACK_BUDGET_SECONDS=20
# Server-only credentials; never use VITE_ variables or commit real values.
NEXUS_EMAIL=
NEXUS_PASSWORD=
NEXUS_PAGE_SIZE=25
NEXUS_MAX_PAGES=2
NEXUS_TIMEOUT_SECONDS=5
NEXUS_BUDGET_SECONDS=20
